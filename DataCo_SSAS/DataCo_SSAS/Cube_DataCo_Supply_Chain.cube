  <Kpis>
    <Kpi dwd:design-time-name="cf89643d-5921-418a-98ba-d01b3149e340">
      <ID>KPI</ID>
      <Name>Late Delivery Rate KPI</Name>
      <AssociatedMeasureGroupID>FACT ORDER ITEM</AssociatedMeasureGroupID>
      <Value>[Measures].[Late Delivery Risk]</Value>
      <Goal>0.4</Goal>
      <Status>Case
  When KPIValue("Late Delivery Rate KPI") &lt;= 0.3 Then 1
  When KPIValue("Late Delivery Rate KPI") &lt;= 0.5 Then 0
  Else -1
End</Status>
